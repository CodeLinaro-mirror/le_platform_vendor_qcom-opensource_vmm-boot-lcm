[Unit]
Description = Gvm Boot Lifecycle Manager
After = remote-fs.target vmm_drv.service disksymlink.service
Conflicts = shutdown.target
Before = shutdown.target
DefaultDependencies = no

[Service]
ExecStart = /usr/bin/vmm-boot-lcm

[Install]
WantedBy=multi-user.target
