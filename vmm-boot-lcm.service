[Unit]
Description = Gvm Boot Lifecycle Manager
After = remote-fs.target vmm_drv.service disksymlink.service vmm-ramdump.service
Conflicts = shutdown.target
Before = shutdown.target
DefaultDependencies = no

[Service]
Slice = gvm.slice
ExecStart = /usr/bin/vmm-boot-lcm

[Install]
WantedBy=multi-user.target
