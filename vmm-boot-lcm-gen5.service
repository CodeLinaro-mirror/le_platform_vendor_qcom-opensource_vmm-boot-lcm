[Unit]
Description = Gvm Boot Lifecycle Manager
After = remote-fs.target vmm_drv.service disksymlink.service
Conflicts = shutdown.target
Before = shutdown.target
DefaultDependencies = no

[Service]
Slice = gvm.slice
ExecStart = /usr/bin/vmm-boot-lcm

[Install]
WantedBy = single-gvm.target
WantedBy = multi-gvm.target
WantedBy = safe-ivi.target
WantedBy = nonsafe-ivi.target
WantedBy = flex.target